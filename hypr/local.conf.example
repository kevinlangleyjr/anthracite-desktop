# Per-machine Hyprland settings. install.sh copies this to local.conf, which
# is gitignored — put anything host-specific here, not in hyprland.conf.
# Reference: https://wiki.hyprland.org/Configuring/Monitors/

# Laptop panel (X1 Carbon Gen 10 1920x1200, no scaling):
# monitor = eDP-1, 1920x1200@60, 0x0, 1

# External display example, positioned to the right:
# monitor = DP-1, 2560x1440@144, 1920x0, 1

# Fallback for anything unlisted:
monitor = , preferred, auto, 1

# Host-specific env, e.g.:
# env = GDK_SCALE,1
